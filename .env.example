# Environment variables for miniyard
# Copy this file to .env.local and fill in values as needed.

# Sentry – DSN is public (safe to commit); get it from sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=https://3ca5b25458aeca2fe07d10eb982fd3f9@o4511450567802880.ingest.de.sentry.io/4511511910744144

# Sentry auth token – SECRET, never commit the real value
# Required for source map upload during builds (CI + Netlify)
# Get it from sentry.io → Settings → Auth Tokens → Create New Token (scope: project:releases, org:read)
SENTRY_AUTH_TOKEN=

# Codecov token – SECRET, never commit the real value
# Used by the Next.js bundle analysis plugin during builds and by the CI upload action
# In production: set as a GitHub Actions secret (not here)
# Get it from app.codecov.io → your repo → Settings → Repository Tokens
CODECOV_TOKEN=
